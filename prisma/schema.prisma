generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {\n  USER\n  ADMIN\n}\n\nenum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum LedgerType {
  TOP_UP
  SMS_RESERVATION
  SMS_CHARGE
  SMS_REFUND
  MANUAL_ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum CampaignStatus {
  DRAFT
  VALIDATING
  READY
  SENDING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum RecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  REJECTED
  REFUNDED
}

enum ConsentSource {
  WEB_FORM
  PAPER_FORM
  CONTRACT
  IMPORT
  API
  OTHER
}

model User {
  id                  String        @id @default(cuid())
  email               String?       @unique
  phone               String?       @unique
  passwordHash        String
  fullName            String?
  organizationName    String?
  status              UserStatus    @default(PENDING)\n  role                UserRole      @default(USER)
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  contacts            Contact[]
  creditAccount       CreditAccount?
  payments            Payment[]
  campaigns           SmsCampaign[]
  sessions            UserSession[]
  consentRecords      ContactConsent[]
  suppressionEntries  SuppressionEntry[]
  apiTokens           ApiToken[]

  @@index([status, createdAt])
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model CreditAccount {
  id             String        @id @default(cuid())
  userId         String        @unique
  balance        BigInt        @default(0)\n  packageCode    String        @default("STARTER")\n  packageCredits BigInt        @default(0)
  currency       String        @default("MNT")
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries  CreditLedger[]

  @@index([updatedAt])
}

model CreditLedger {
  id             String        @id @default(cuid())
  accountId      String
  type           LedgerType
  amount         BigInt
  balanceAfter   BigInt
  referenceType  String
  referenceId    String
  idempotencyKey String        @unique
  description    String?
  createdAt      DateTime      @default(now())
  account        CreditAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([referenceType, referenceId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  provider          String        @default("WIRE")
  providerIntentId  String?       @unique
  checkoutUrl       String?
  amountMnt         BigInt
  creditAmount      BigInt
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @unique
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
}

model Contact {
  id             String           @id @default(cuid())
  userId         String
  phoneE164      String
  displayName    String?
  tags           String[]         @default([])
  source         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  consent        ContactConsent[]

  @@unique([userId, phoneE164])
  @@index([userId, createdAt])
}

model ContactConsent {
  id             String        @id @default(cuid())
  userId         String
  contactId      String?
  phoneE164      String
  granted        Boolean
  source         ConsentSource
  evidence       String?
  capturedAt     DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId, phoneE164, capturedAt])
}

model SuppressionEntry {
  id          String   @id @default(cuid())
  userId      String
  phoneE164   String
  reason      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phoneE164])
  @@index([phoneE164])
}

model Operator {
  id          String             @id @default(cuid())
  code        String             @unique
  nameMn      String
  nameEn      String?
  active      Boolean            @default(true)
  prefixes    NumberPrefixRange[]
}

model NumberPrefixRange {
  id              String   @id @default(cuid())
  prefix          String
  nationalLength  Int      @default(8)
  operatorId      String?
  sourceName      String
  sourceUrl       String?
  sourceUpdatedAt DateTime?
  validFrom       DateTime?
  validUntil      DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  operator        Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([prefix, validFrom, validUntil])
  @@index([verifiedAt])
}

model SmsCampaign {
  id                String          @id @default(cuid())
  userId            String
  name              String?
  message           String
  encoding          String
  segments          Int
  recipientCount   Int             @default(0)
  estimatedCredits BigInt          @default(0)
  reservedCredits  BigInt          @default(0)
  chargedCredits   BigInt          @default(0)
  status            CampaignStatus  @default(DRAFT)
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  recipients        SmsRecipient[]

  @@index([userId, status, createdAt])
  @@index([scheduledAt, status])
}

model SmsRecipient {
  id                String          @id @default(cuid())
  campaignId        String
  phoneE164         String
  status            RecipientStatus @default(PENDING)
  segments          Int
  creditsCharged    BigInt          @default(0)
  providerMessageId String?         @unique
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  campaign          SmsCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phoneE164])
  @@index([campaignId, status])
  @@index([phoneE164, createdAt])
}

model ProviderBatch {
  id               String   @id @default(cuid())
  provider         String
  providerBatchId  String   @unique
  campaignId       String
  status           String
  recipientCount   Int
  responseSnapshot Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([campaignId, status])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  provider       String
  providerEventId String
  eventType      String
  payload        Json
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([provider, processedAt, createdAt])
}
